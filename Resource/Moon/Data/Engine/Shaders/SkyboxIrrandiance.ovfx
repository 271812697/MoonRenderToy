#shader vertex
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
#include ":Shaders/Common/Utils.ovfxh"

layout (location = 0) in vec3 geo_Pos;
layout (location = 1) in vec2 geo_TexCoords;

out VS_OUT
{
    vec3 dir;
} vs_out;

void main()
{
  vs_out.dir = geo_Pos;
  gl_Position = ubo_Projection *ubo_View  * vec4(ubo_ViewPos +  geo_Pos, 1.0);
 
}

#shader fragment
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
#include ":Shaders/Common/Utils.ovfxh"

in VS_OUT
{
    vec3 dir;
} fs_in;

uniform samplerCube SkyboxCube;
out vec4 FRAGMENT_COLOR;
#define PI         3.14159265358979323
#define INV_PI     0.31830988618379067
#define INV_TWO_PI 0.15915494309189533
void main()
{

    vec3 N = normalize(fs_in.dir);

    vec3 irradiance = vec3(0.0);   
    
    // tangent space calculation from origin point
    vec3 up    = vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up         = normalize(cross(N, right));
       
    float sampleDelta = 0.025;
    float nrSamples = 0.0f;
    for(float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta)
    {
        for(float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta)
        {
            // spherical to cartesian (in tangent space)
            vec3 tangentSample = vec3(sin(theta) * cos(phi),  sin(theta) * sin(phi), cos(theta));
            // tangent space to world
            vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * N; 
            //irradiance += textureLod(SkyboxCube, sampleVec,0).rgb * cos(theta) * sin(theta);
            irradiance += texture(SkyboxCube, sampleVec).rgb * cos(theta) * sin(theta);
            nrSamples++;
        }
    }
    irradiance = PI * irradiance * (1.0 / float(nrSamples));
    
    FRAGMENT_COLOR = vec4(irradiance, 1.0);
   
}