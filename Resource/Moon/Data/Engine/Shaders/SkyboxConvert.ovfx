
#feature SKY_Convert

#shader vertex
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
#include ":Shaders/Common/Utils.ovfxh"

layout (location = 0) in vec3 geo_Pos;
layout (location = 1) in vec2 geo_TexCoords;

out VS_OUT
{
    vec3 dir;
} vs_out;

void main()
{
    vs_out.dir = geo_Pos;
    gl_Position = ubo_Projection *ubo_View  * vec4(ubo_ViewPos +  geo_Pos, 1.0);
}

#shader fragment
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
#include ":Shaders/Common/Utils.ovfxh"

in VS_OUT
{
    vec3 dir;
} fs_in;
#if defined(SKY_Convert)
uniform sampler2D u_SkyBoxTexture;
#else
uniform samplerCube SkyboxCube;
#endif
 



out vec4 FRAGMENT_COLOR;
#define PI         3.14159265358979323
#define INV_PI     0.31830988618379067
#define INV_TWO_PI 0.15915494309189533
void main()
{

    vec3 d=normalize(fs_in.dir);
#if defined(SKY_Convert)  
    
    float theta = acos(clamp(d.y, -1.0, 1.0));
	vec2 uv = vec2((PI + atan(d.z, d.x)) * INV_TWO_PI, 1.0-theta * INV_PI);
    FRAGMENT_COLOR = texture(u_SkyBoxTexture, uv) ;
#else
    //FRAGMENT_COLOR =vec4(texture(SkyboxCube, normalize(vec3(1,1,1))).rgb,1.0f);
    //textureLod(environmentMap, N, environmentMaxLOD).rgb;
    vec3 color=textureLod(SkyboxCube,d,0).rgb;
    FRAGMENT_COLOR =vec4(color,1.0f);
#endif
   
}
