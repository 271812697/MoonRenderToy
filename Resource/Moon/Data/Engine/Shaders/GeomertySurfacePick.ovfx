#shader vertex
#version 450 core
#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
layout (location = 0) in vec3 geo_Pos;
layout (location = 1) in vec2 geo_TexCoords;

out vec3 VSOUT_World;
out vec2 VstexCoords;

void main()
{
    vec4 worldPos = ubo_Model * vec4(geo_Pos, 1.0);
    VSOUT_World=worldPos.xyz;
    VstexCoords = geo_TexCoords;
    gl_Position = ubo_Projection * ubo_View * worldPos;
}

#shader fragment
#version 450 core
#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
in vec2 VstexCoords;
in vec3 VSOUT_World;
out vec4 FRAGMENT_COLOR;

void main()
{
    if(ubo_enableClip==1){
        float offsetw=dot(ubo_plane.xyz,VSOUT_World)+ubo_plane.w;
        if(offsetw>0){
            discard;
        }
    }
    int actorId = int(round(VstexCoords.y));
    int r = actorId & 0xFF;
    int g = (actorId >> 8) & 0xFF;
    int b = (actorId >> 16) & 0xFF; 
    FRAGMENT_COLOR = vec4(r / 255.0, g / 255.0, b / 255.0, 1.0);
}