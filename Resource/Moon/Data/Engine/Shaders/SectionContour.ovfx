#shader vertex
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"

layout (location = 0) in vec3 geo_Pos;

out vec3 FragPos;

void main()
{
    FragPos = vec3(ubo_Model * vec4(geo_Pos, 1.0));
    gl_Position = ubo_Projection * ubo_View * vec4(FragPos, 1.0);
}


#shader geomerty
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"

layout(triangles) in;
layout(line_strip, max_vertices = 2) out;

in vec3 FragPos[];

uniform float u_DepthBias = 1e-5;

void main()
{
    float d[3];
    for (int i = 0; i < 3; i++)
        d[i] = dot(ubo_plane.xyz, FragPos[i]) + ubo_plane.w;

    int posCnt = 0;
    int negCnt = 0;
    for (int i = 0; i < 3; i++)
    {
        if (d[i] >= 0.0) posCnt++;
        else negCnt++;
    }
    if (posCnt == 0 || negCnt == 0) return;

    // Emit the segment where the triangle crosses the plane.
    for (int i = 0; i < 3; i++)
    {
        int j = (i + 1) % 3;
        if ((d[i] >= 0.0) != (d[j] >= 0.0))
        {
            float t = d[i] / (d[i] - d[j]);
            vec3 p = mix(FragPos[i], FragPos[j], t);
            gl_Position = ubo_Projection * ubo_View * vec4(p, 1.0);
            // Nudge the depth toward the camera so coplanar lines win against
            // the surfaces they lie on.
            gl_Position.z -= u_DepthBias * gl_Position.w;
            EmitVertex();
        }
    }
    EndPrimitive();
}


#shader fragment
#version 450 core

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"

out vec4 FRAGMENT_COLOR;
uniform vec3 color = vec3(1.0, 0.0, 1.0);

void main()
{
    FRAGMENT_COLOR = vec4(color, 1.0);
}
